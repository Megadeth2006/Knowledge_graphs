<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
   xmlns:ex="https://example.org/rental-kg#"
   xmlns:geo="http://www.opengis.net/ont/geosparql#"
   xmlns:owl="http://www.w3.org/2002/07/owl#"
   xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
   xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
>
  <rdf:Description rdf:about="https://example.org/rental-kg#MetroStation">
    <rdfs:label xml:lang="ru">Станция метро</rdfs:label>
    <rdfs:comment xml:lang="ru">Объект транспортного обслуживания, предоставляющий доступ к метрополитену. В текущем наборе представлен одной репрезентативной точкой, а не всеми входами.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:subClassOf rdf:resource="https://example.org/rental-kg#Amenity"/>
    <owl:disjointWith rdf:resource="https://example.org/rental-kg#Park"/>
    <owl:disjointWith rdf:resource="https://example.org/rental-kg#Supermarket"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D12_home">
    <ex:inBuilding rdf:resource="https://example.org/rental-kg#D12_building"/>
    <ex:rooms rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ex:rooms>
    <ex:areaM2 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">49</ex:areaM2>
    <ex:floor rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13</ex:floor>
    <rdf:type rdf:resource="https://example.org/rental-kg#Apartment"/>
    <rdfs:label xml:lang="ru">Учебная квартира D12</rdfs:label>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D12_source"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#Park">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="ru">Парк</rdfs:label>
    <rdfs:comment xml:lang="ru">Озеленённая территория для отдыха. В пилоте представлена опорной точкой.</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://example.org/rental-kg#Amenity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D04_building">
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#D04_building_point"/>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D04_source"/>
    <rdf:type rdf:resource="https://example.org/rental-kg#Building"/>
    <ex:floorsTotal rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ex:floorsTotal>
    <ex:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Учебный адрес D04</ex:address>
    <rdfs:label xml:lang="ru">Учебное здание D04</rdfs:label>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:inDistrict rdf:resource="https://example.org/rental-kg#DemoDistrict"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D10_source">
    <rdfs:label xml:lang="ru">Учебный источник D10</rdfs:label>
    <rdf:type rdf:resource="https://example.org/rental-kg#SourceRecord"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/synthetic/D10</ex:sourceUrl>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D11_building">
    <rdfs:label xml:lang="ru">Учебное здание D11</rdfs:label>
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#D11_building_point"/>
    <ex:inDistrict rdf:resource="https://example.org/rental-kg#DemoDistrict"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Учебный адрес D11</ex:address>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D11_source"/>
    <ex:floorsTotal rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ex:floorsTotal>
    <rdf:type rdf:resource="https://example.org/rental-kg#Building"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D03_building">
    <rdf:type rdf:resource="https://example.org/rental-kg#Building"/>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D03_source"/>
    <ex:floorsTotal rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ex:floorsTotal>
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#D03_building_point"/>
    <ex:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Учебный адрес D03</ex:address>
    <ex:inDistrict rdf:resource="https://example.org/rental-kg#DemoDistrict"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <rdfs:label xml:lang="ru">Учебное здание D03</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D12_building">
    <rdf:type rdf:resource="https://example.org/rental-kg#Building"/>
    <ex:inDistrict rdf:resource="https://example.org/rental-kg#DemoDistrict"/>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D12_source"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Учебный адрес D12</ex:address>
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#D12_building_point"/>
    <rdfs:label xml:lang="ru">Учебное здание D12</rdfs:label>
    <ex:floorsTotal rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ex:floorsTotal>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#depositRub">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="https://example.org/rental-kg#ListingSnapshot"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    <rdfs:label xml:lang="ru">залог, руб.</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#M2">
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <rdf:type rdf:resource="https://example.org/rental-kg#MetroStation"/>
    <rdfs:label xml:lang="ru">Учебное метро Б</rdfs:label>
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#M2_point"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://www.opengis.net/ont/geosparql#asWKT">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="ru">геометрия в WKT</rdfs:label>
    <rdfs:domain rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <rdfs:range rdf:resource="http://www.opengis.net/ont/geosparql#wktLiteral"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D10_building">
    <rdf:type rdf:resource="https://example.org/rental-kg#Building"/>
    <ex:floorsTotal rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ex:floorsTotal>
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#D10_building_point"/>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D10_source"/>
    <ex:inDistrict rdf:resource="https://example.org/rental-kg#DemoDistrict"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <rdfs:label xml:lang="ru">Учебное здание D10</rdfs:label>
    <ex:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Учебный адрес D10</ex:address>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#M1">
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#M1_point"/>
    <rdfs:label xml:lang="ru">Учебное метро А</rdfs:label>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <rdf:type rdf:resource="https://example.org/rental-kg#MetroStation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#P2_point">
    <rdf:type rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <ex:geometryKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthetic</ex:geometryKind>
    <geo:asWKT rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POINT (30.34000000 59.94600000)</geo:asWKT>
    <rdfs:label xml:lang="ru">Опорная точка</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D11">
    <ex:utilitiesRubMonth rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4000</ex:utilitiesRubMonth>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:offers rdf:resource="https://example.org/rental-kg#D11_home"/>
    <rdfs:label xml:lang="ru">Учебное объявление D11</rdfs:label>
    <ex:observedOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</ex:observedOn>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D11_source"/>
    <rdf:type rdf:resource="https://example.org/rental-kg#ListingSnapshot"/>
    <ex:term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">long_term</ex:term>
    <ex:rentRubMonth rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">42000</ex:rentRubMonth>
    <ex:depositRub rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30000</ex:depositRub>
    <ex:commissionRub rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</ex:commissionRub>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D12">
    <ex:term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">long_term</ex:term>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D12_source"/>
    <ex:offers rdf:resource="https://example.org/rental-kg#D12_home"/>
    <ex:commissionRub rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</ex:commissionRub>
    <ex:observedOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</ex:observedOn>
    <ex:utilitiesRubMonth rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4000</ex:utilitiesRubMonth>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:petsAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:petsAllowed>
    <ex:rentRubMonth rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30000</ex:rentRubMonth>
    <rdf:type rdf:resource="https://example.org/rental-kg#ListingSnapshot"/>
    <rdfs:label xml:lang="ru">Учебное объявление D12</rdfs:label>
    <ex:depositRub rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30000</ex:depositRub>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#District">
    <rdfs:label xml:lang="ru">Район</rdfs:label>
    <rdfs:subClassOf rdf:resource="https://example.org/rental-kg#Place"/>
    <owl:disjointWith rdf:resource="https://example.org/rental-kg#Building"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="ru">Территориальная адресная единица внутри города, в которую входит здание. Членство определяется уровнем адресной иерархии, а не близостью к жилью.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D08_source">
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <rdfs:label xml:lang="ru">Учебный источник D08</rdfs:label>
    <ex:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/synthetic/D08</ex:sourceUrl>
    <rdf:type rdf:resource="https://example.org/rental-kg#SourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D02_source">
    <rdf:type rdf:resource="https://example.org/rental-kg#SourceRecord"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/synthetic/D02</ex:sourceUrl>
    <rdfs:label xml:lang="ru">Учебный источник D02</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D02_building">
    <ex:address rdf:datatype="http://www.w3.org/2001/XMLSchema#string">Учебный адрес D02</ex:address>
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#D02_building_point"/>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D02_source"/>
    <ex:floorsTotal rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16</ex:floorsTotal>
    <ex:inDistrict rdf:resource="https://example.org/rental-kg#DemoDistrict"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <rdfs:label xml:lang="ru">Учебное здание D02</rdfs:label>
    <rdf:type rdf:resource="https://example.org/rental-kg#Building"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D11_building_point">
    <rdfs:label xml:lang="ru">Опорная точка</rdfs:label>
    <rdf:type rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
    <geo:asWKT rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POINT (30.33300000 59.94120000)</geo:asWKT>
    <ex:geometryKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthetic</ex:geometryKind>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#StudentWithPet">
    <ex:maxMetroDistanceM rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">500</ex:maxMetroDistanceM>
    <ex:requiresPets rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:requiresPets>
    <rdf:type rdf:resource="https://example.org/rental-kg#RenterProfile"/>
    <rdfs:label xml:lang="ru">Студент с питомцем</rdfs:label>
    <ex:maxRentRubMonth rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">40000</ex:maxRentRubMonth>
    <ex:preferredCity rdf:resource="https://example.org/rental-kg#DemoCity"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#Amenity">
    <rdfs:label xml:lang="ru">Объект инфраструктуры</rdfs:label>
    <owl:disjointWith rdf:resource="https://example.org/rental-kg#SourceRecord"/>
    <owl:disjointWith rdf:resource="https://example.org/rental-kg#RenterProfile"/>
    <owl:disjointWith rdf:resource="https://example.org/rental-kg#MetroEntrance"/>
    <owl:disjointWith rdf:resource="https://example.org/rental-kg#ListingSnapshot"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="ru">Объект обслуживания или отдыха, близость которого важна при подборе жилья.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D02_building_point">
    <ex:geometryKind rdf:datatype="http://www.w3.org/2001/XMLSchema#string">synthetic</ex:geometryKind>
    <rdfs:label xml:lang="ru">Опорная точка</rdfs:label>
    <geo:asWKT rdf:datatype="http://www.opengis.net/ont/geosparql#wktLiteral">POINT (30.30600000 59.92400000)</geo:asWKT>
    <rdf:type rdf:resource="http://www.opengis.net/ont/geosparql#Geometry"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D03_home">
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:inBuilding rdf:resource="https://example.org/rental-kg#D03_building"/>
    <rdf:type rdf:resource="https://example.org/rental-kg#Apartment"/>
    <ex:rooms rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">0</ex:rooms>
    <ex:floor rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4</ex:floor>
    <ex:areaM2 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">31</ex:areaM2>
    <rdfs:label xml:lang="ru">Учебная квартира D03</rdfs:label>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D03_source"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#DemoDistrict">
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <rdf:type rdf:resource="https://example.org/rental-kg#District"/>
    <rdfs:label xml:lang="ru">Учебный район</rdfs:label>
    <ex:inCity rdf:resource="https://example.org/rental-kg#DemoCity"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#S1">
    <rdfs:label xml:lang="ru">Учебный магазин А</rdfs:label>
    <rdf:type rdf:resource="https://example.org/rental-kg#Supermarket"/>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <geo:hasGeometry rdf:resource="https://example.org/rental-kg#S1_point"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#locatedIn">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
    <rdfs:range rdf:resource="https://example.org/rental-kg#Place"/>
    <rdfs:label xml:lang="ru">расположено в</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#isSynthetic">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    <rdfs:label xml:lang="ru">синтетические данные</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D11_source">
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:sourceUrl rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://example.org/synthetic/D11</ex:sourceUrl>
    <rdfs:label xml:lang="ru">Учебный источник D11</rdfs:label>
    <rdf:type rdf:resource="https://example.org/rental-kg#SourceRecord"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#floorsTotal">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="https://example.org/rental-kg#Building"/>
    <rdfs:label xml:lang="ru">этажей в доме</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#inBuilding">
    <rdfs:range rdf:resource="https://example.org/rental-kg#Building"/>
    <rdfs:subPropertyOf rdf:resource="https://example.org/rental-kg#locatedIn"/>
    <rdfs:label xml:lang="ru">находится в здании</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="https://example.org/rental-kg#Dwelling"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#D10">
    <rdfs:label xml:lang="ru">Учебное объявление D10</rdfs:label>
    <ex:rentRubMonth rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">38000</ex:rentRubMonth>
    <ex:petsAllowed rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">false</ex:petsAllowed>
    <ex:commissionRub rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">0</ex:commissionRub>
    <rdf:type rdf:resource="https://example.org/rental-kg#ListingSnapshot"/>
    <ex:offers rdf:resource="https://example.org/rental-kg#D10_home"/>
    <ex:depositRub rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">30000</ex:depositRub>
    <ex:isSynthetic rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</ex:isSynthetic>
    <ex:term rdf:datatype="http://www.w3.org/2001/XMLSchema#string">long_term</ex:term>
    <ex:observedOn rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-10-22</ex:observedOn>
    <ex:hasSource rdf:resource="https://example.org/rental-kg#D10_source"/>
    <ex:utilitiesRubMonth rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4000</ex:utilitiesRubMonth>
  </rdf:Description>
  <rdf:Description rdf:about="https://example.org/rental-kg#utilitiesRubMonth">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
