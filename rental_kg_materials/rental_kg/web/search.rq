PREFIX ex: <https://example.org/rental-kg#>
PREFIX dct: <http://purl.org/dc/terms/>
SELECT ?listing ?address ?rent ?date ?url ?identifier ?pets ?station ?seconds
       (?rent <= ?budget AS ?priceOK)
       ((! ?needPets || COALESCE(?pets, false)) AS ?petsOK)
       ((?noLimit || COALESCE(?seconds <= ?timeLimit, false)) AS ?walkOK)
WHERE {
    ex:IslandSample dct:hasPart ?listing .
    ?listing a ex:ListingSnapshot ; ex:isSynthetic false ; ex:term ?term ;
        ex:offers/ex:inBuilding/ex:address ?address ;
        ex:rentRubMonth ?rent ; ex:observedOn ?date ; ex:hasSource ?source .
    FILTER (STR(?term) = "long_term")
    ?source ex:sourceUrl ?url ; dct:identifier ?identifier .
    OPTIONAL { ?listing ex:petsAllowed ?pets }
    OPTIONAL { ?listing ex:nearestWalkSeconds ?seconds ; ex:nearestStationLabel ?station }
}
ORDER BY ?rent ?listing
