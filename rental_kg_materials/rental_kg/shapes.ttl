@prefix ex: <https://example.org/rental-kg#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
ex:ListingShape a sh:NodeShape; sh:targetClass ex:ListingSnapshot;
 sh:property [ sh:path ex:offers; sh:minCount 1; sh:maxCount 1; sh:class ex:Dwelling ],
 [ sh:path ex:rentRubMonth; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:decimal; sh:minExclusive 0 ],
 [ sh:path ex:observedOn; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:date ],
 [ sh:path ex:hasSource; sh:minCount 1; sh:class ex:SourceRecord ],
 [ sh:path ex:petsAllowed; sh:maxCount 1; sh:datatype xsd:boolean ],
 [ sh:path ex:depositRub; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive 0 ],
 [ sh:path ex:commissionRub; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive 0 ],
 [ sh:path ex:utilitiesRubMonth; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive 0 ],
 [ sh:path ex:term; sh:minCount 1; sh:maxCount 1; sh:in ("long_term"^^xsd:string "fixed_short_term"^^xsd:string) ] .
ex:DwellingShape a sh:NodeShape; sh:targetClass ex:Dwelling;
 sh:property [ sh:path ex:areaM2; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:decimal; sh:minExclusive 0 ],
 [ sh:path ex:rooms; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 0 ],
 [ sh:path ex:inBuilding; sh:minCount 1; sh:maxCount 1; sh:class ex:Building ],
 [ sh:path ex:floor; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ];
 sh:sparql [ sh:message "Этаж квартиры выше этажности здания";
 sh:select """PREFIX ex: <https://example.org/rental-kg#>
 SELECT $this WHERE { $this ex:floor ?f; ex:inBuilding/ex:floorsTotal ?n. FILTER(?f > ?n) }""" ] .
ex:DistanceShape a sh:NodeShape; sh:targetClass ex:DistanceMeasurement;
 sh:property [ sh:path ex:fromDwelling; sh:minCount 1; sh:maxCount 1; sh:class ex:Dwelling ],
 [ sh:path ex:toAmenity; sh:minCount 1; sh:maxCount 1; sh:class ex:Amenity ],
 [ sh:path ex:distanceM; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive 0 ],
 [ sh:path ex:usesMethod; sh:minCount 1; sh:maxCount 1; sh:class ex:MeasurementMethod ] .
ex:CoordinateShape a sh:NodeShape;
 sh:targetClass ex:Building, ex:Amenity;
 sh:targetSubjectsOf ex:latitude, ex:longitude;
 sh:or ( [ sh:class ex:Building ] [ sh:class ex:Amenity ] );
 sh:node ex:CoordinatePairShape;
 sh:property [ sh:path ex:latitude; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive -90; sh:maxInclusive 90 ],
 [ sh:path ex:longitude; sh:maxCount 1; sh:datatype xsd:decimal; sh:minInclusive -180; sh:maxInclusive 180 ] .

# A point is either unknown or supplied with both coordinates.
ex:CoordinatePairShape a sh:NodeShape;
 sh:or (
  [ sh:property [ sh:path ex:latitude; sh:maxCount 0 ], [ sh:path ex:longitude; sh:maxCount 0 ] ]
  [ sh:property [ sh:path ex:latitude; sh:minCount 1 ], [ sh:path ex:longitude; sh:minCount 1 ] ]
 ) .

ex:BuildingShape a sh:NodeShape; sh:targetClass ex:Building;
 sh:property [ sh:path ex:floorsTotal; sh:minCount 1; sh:maxCount 1; sh:datatype xsd:integer; sh:minInclusive 1 ],
 [ sh:path ex:address; sh:maxCount 1; sh:datatype xsd:string ],
 [ sh:path ex:inDistrict; sh:maxCount 1; sh:class ex:District ] .

ex:DistrictShape a sh:NodeShape; sh:targetClass ex:District;
 sh:property [ sh:path ex:inCity; sh:maxCount 1; sh:class ex:City ] .

ex:LocationShape a sh:NodeShape; sh:targetSubjectsOf ex:locatedIn;
 sh:or ( [ sh:class ex:Dwelling ] [ sh:class ex:Place ] );
 sh:property [ sh:path ex:locatedIn; sh:class ex:Place ];
 sh:sparql [ sh:message "Нарушен порядок адресных уровней: жильё → здание → район → город";
 sh:select """PREFIX ex: <https://example.org/rental-kg#>
 SELECT $this ?value WHERE {
  $this ex:locatedIn ?value .
  FILTER NOT EXISTS {
   { $this a ex:Dwelling . ?value a ?targetClass .
     FILTER(?targetClass IN (ex:Building, ex:District, ex:City)) }
   UNION
   { $this a ex:Building . ?value a ?targetClass .
     FILTER(?targetClass IN (ex:District, ex:City)) }
   UNION
   { $this a ex:District . ?value a ex:City . }
  }
 }""" ] .

# Domain/range inference may add an expected class to an incorrectly linked node.
# Check the resulting incompatible types instead of accepting that inferred class.
ex:DisjointTypesShape a sh:NodeShape; sh:targetSubjectsOf rdf:type;
 sh:sparql [ sh:message "Объект одновременно принадлежит непересекаемым классам";
 sh:select """PREFIX owl: <http://www.w3.org/2002/07/owl#>
 SELECT DISTINCT $this WHERE {
  $this a ?left, ?right .
  ?left owl:disjointWith ?right .
 }""" ] .
