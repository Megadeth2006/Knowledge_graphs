owl:Class owl:sameAs owl:Class .

owl:Nothing a owl:Class ;
    rdfs:subClassOf geo:Geometry,
        owl:Nothing,
        owl:Thing,
        ex:Amenity,
        ex:Apartment,
        ex:Building,
        ex:City,
        ex:District,
        ex:Dwelling,
