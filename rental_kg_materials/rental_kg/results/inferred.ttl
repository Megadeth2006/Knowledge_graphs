        ex:MetroEntrance,
        ex:MetroStation,
        ex:Park,
        ex:Place,
        ex:RenterProfile,
        ex:SourceRecord,
        ex:Supermarket ;
    owl:equivalentClass owl:Nothing ;
    owl:sameAs owl:Nothing .

