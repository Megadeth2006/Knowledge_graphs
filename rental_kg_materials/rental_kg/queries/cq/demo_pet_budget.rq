PREFIX ex: <https://example.org/rental-kg#>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
PREFIX uom: <http://www.opengis.net/def/uom/OGC/1.0/>
SELECT ?listing ?rent (MIN(?distance) AS ?metroDistanceM) WHERE {
    ex:StudentWithPet ex:maxRentRubMonth ?budget ;
        ex:maxMetroDistanceM ?limit ; ex:requiresPets true .
    ?listing a ex:ListingSnapshot ; ex:isSynthetic true ; ex:term ?term ;
        ex:offers ?home ; ex:rentRubMonth ?rent ; ex:petsAllowed true .
    ?home ex:inBuilding/geo:hasGeometry/geo:asWKT ?buildingWkt .
    ?metro a ex:MetroStation ; ex:isSynthetic true ;
        geo:hasGeometry/geo:asWKT ?metroWkt .
    BIND(geof:distance(?buildingWkt, ?metroWkt, uom:metre) AS ?distance)
    FILTER(STR(?term) = "long_term" && ?rent <= ?budget && ?distance <= ?limit)
}
GROUP BY ?listing ?rent
ORDER BY ?rent ?listing
