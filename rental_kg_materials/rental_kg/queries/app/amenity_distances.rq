PREFIX ex: <https://example.org/rental-kg#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX geof: <http://www.opengis.net/def/function/geosparql/>
PREFIX uom: <http://www.opengis.net/def/uom/OGC/1.0/>
# Geodesic distance from each island building to every real object of ?kind.
SELECT DISTINCT ?building ?amenity ?label ?pointKind ?metres WHERE {
    ex:IslandSample dct:hasPart ?listing .
    ?listing ex:offers/ex:inBuilding ?building .
    ?building geo:hasGeometry/geo:asWKT ?origin .
    ?amenity a ?kind ; ex:isSynthetic false ; geo:hasGeometry ?geometry .
    ?geometry geo:asWKT ?target .
    OPTIONAL { ?geometry ex:geometryKind ?pointKind }
    OPTIONAL { ?amenity rdfs:label ?label }
    BIND(geof:distance(?origin, ?target, uom:metre) AS ?metres)
}
