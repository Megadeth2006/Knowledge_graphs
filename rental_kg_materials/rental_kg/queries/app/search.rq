PREFIX ex: <https://example.org/rental-kg#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
# Facts of the current island slice; unknown values stay unbound.
SELECT ?listing ?home ?building ?address ?rent ?date ?url ?identifier ?pets
       ?area ?rooms ?floor ?floorsTotal ?geometryKind
WHERE {
    ex:IslandSample dct:hasPart ?listing .
    ?listing a ex:ListingSnapshot ; ex:isSynthetic false ; ex:term ?term ;
        ex:offers ?home ; ex:rentRubMonth ?rent ; ex:observedOn ?date ;
        ex:hasSource ?source .
    FILTER (STR(?term) = "long_term")
    ?home ex:inBuilding ?building .
    ?building ex:address ?address .
    ?source ex:sourceUrl ?url ; dct:identifier ?identifier .
    OPTIONAL { ?listing ex:petsAllowed ?pets }
    OPTIONAL { ?home ex:areaM2 ?area }
    OPTIONAL { ?home ex:rooms ?rooms }
    OPTIONAL { ?home ex:floor ?floor }
    OPTIONAL { ?building ex:floorsTotal ?floorsTotal }
    OPTIONAL { ?building geo:hasGeometry/ex:geometryKind ?geometryKind }
}
ORDER BY ?rent ?listing
